PORT=3000
NODE_ENV=production

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=sistema_cilindros

JWT_SECRET=
JWT_EXPIRES_IN=8h

# URL pública del frontend en Vercel (puede ser varias separadas por coma)
FRONTEND_URL=https://tu-app.vercel.app

# URL pública de este backend (Railway/Render)
BACKEND_URL=https://tu-api.up.railway.app

# Recomendado en producción (las imágenes no se pierden al reiniciar el servidor)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# En Railway/MySQL remoto use true
DB_SSL=true
