PORT=3000
NODE_ENV=production

# Opción A: variables DB_* (manual)
# Si MySQL está en el MISMO proyecto Railway, use el host PRIVADO (ej. mysql.railway.internal)
# Si conecta por internet, use el host público (ej. xxx.proxy.rlwy.net) y el puerto público
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=railway

# Opción B: pegar la URL completa de Railway MySQL (recomendado)
# MYSQL_URL=mysql://user:pass@host:port/railway

JWT_SECRET=
JWT_EXPIRES_IN=8h

FRONTEND_URL=https://cilindrofronted.vercel.app
BACKEND_URL=https://TU-BACKEND-CILINDROS.up.railway.app
# Use siempre el dominio del proyecto venta_cilindro (no otros proyectos)

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

DB_SSL=true
